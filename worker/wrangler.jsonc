{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "erasurekit-relay",
  "main": "src/index.js",
  "compatibility_date": "2025-04-03",
  "routes": [
    {
      "pattern": "api.erasurekit.uk",
      "custom_domain": true
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "<PLACEHOLDER_PRODUCTION_ID>"
    }
  ]
}
